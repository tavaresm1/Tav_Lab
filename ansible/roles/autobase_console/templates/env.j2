# Managed by Ansible — roles/autobase_console. Do not edit on the host.
#
# Consumed by the upstream console/docker-compose.yml at tag
# {{ autobase_console_version }}. AUTH_TOKEN is the Console login secret: it is
# shared by console_api, console_ui and the API's own healthcheck.
AUTH_TOKEN={{ vault_autobase_auth_token }}

# API verbosity. Raise to DEBUG when a deploy fails and the Operations log in
# the UI is not specific enough.
#
# The name matters and is easy to get wrong: upstream's compose file reads
# ${PG_CONSOLE_LOGGER_LEVEL:-INFO} and passes it on as PG_CONSOLE_LOGGER_LEVEL.
# This said PG_CONSOLE_API_LOG_LEVEL until 2026-09-20, which no service reads —
# so setting it to DEBUG changed nothing and the fallback quietly won. A wrong
# variable name in a .env is invisible: compose does not warn about keys nobody
# consumes. Check the tag's compose file before renaming this.
PG_CONSOLE_LOGGER_LEVEL={{ autobase_console_log_level | default('INFO') }}

# DOMAIN / EMAIL are only read by docker-compose.caddy.yml. We terminate TLS
# with `tailscale serve` instead, so they stay unset.
