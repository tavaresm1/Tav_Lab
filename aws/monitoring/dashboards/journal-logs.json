        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {"type": "loki", "uid": "${ds}"},
        "definition": "label_values(unit)",
        "hide": 0,
        "includeAll": true,
        "label": "Unit",
        "multi": true,
        "name": "unit",
        "options": [],
        "query": "label_values(unit)",
        "refresh": 2,
        "regex": "",
