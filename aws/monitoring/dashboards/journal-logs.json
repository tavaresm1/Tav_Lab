  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "TavLab - Home node journal logs",
  "uid": "tavlab-journal-logs",
  "version": 1,
  "weekStart": ""
