{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Journal logs shipped from home nodes by Grafana Alloy into Loki. METRICS ARE NOT HERE -- there is no Prometheus datasource; metrics live in Netdata on :19999 (see the dashboard link above). Loki retention is 720h / 30 days. Only hosts running install-child.sh appear: mon-aws does not ship its own journal.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Netdata (metrics live here, not in Grafana)",
      "tooltip": "There is no Prometheus datasource. All metrics for all three hosts are in Netdata.",
      "type": "link",
      "url": "http://mon-aws:19999"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Uptime Kuma",
      "tooltip": "Synthetic checks against home hosts",
      "type": "link",
      "url": "http://mon-aws:3001"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Total journal lines received in the selected time range, across the selected hosts.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"systemd-journal\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Log lines (range)",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Journal priority err, crit, alert or emerg. Any non-zero value here is worth a look; this is the number the Logs panels at the bottom are filtered to.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"match": "null", "result": {"index": 0, "text": "0"}}, "type": "special"}],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"systemd-journal\", host=~\"$host\", level=~\"err|crit|alert|emerg\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Errors (range)",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Journal priority warning. Expect a steady non-zero baseline on any real Linux host -- watch the trend, not the absolute number.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"match": "null", "result": {"index": 0, "text": "0"}}, "type": "special"}],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "#EAB839", "value": 1}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"systemd-journal\", host=~\"$host\", level=\"warning\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Warnings (range)",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Distinct hosts that shipped at least one line in the range. This is the panel that tells you a child has gone silent -- if it drops, an Alloy agent has stopped, which Netdata's own child check will NOT catch (Netdata streaming and log shipping are independent paths).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"match": "null", "result": {"index": 0, "text": "0"}}, "type": "special"}],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 2}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "count(sum by (host) (count_over_time({job=\"systemd-journal\"}[$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Hosts shipping logs",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "panels": [],
      "title": "Volume",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Lines per second by host. A flat line at zero for one host while the other keeps going means that host's Alloy has stopped, not that the host is quiet.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "logs"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (host) (rate({job=\"systemd-journal\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Lines/sec by host",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Lines per second by journal priority, stacked. Colours are pinned by level so red always means err and above -- do not rely on the classic palette here, it reassigns colours as series appear and disappear.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 45,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "logs"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "emerg"}, "properties": [{"id": "color", "value": {"fixedColor": "dark-red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "alert"}, "properties": [{"id": "color", "value": {"fixedColor": "dark-red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "crit"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "err"}, "properties": [{"id": "color", "value": {"fixedColor": "semi-dark-red", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "warning"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "notice"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "info"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "debug"}, "properties": [{"id": "color", "value": {"fixedColor": "text", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "options": {
        "legend": {"calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (level) (rate({job=\"systemd-journal\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Lines/sec by priority",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "panels": [],
      "title": "Where it comes from",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Noisiest systemd units in the range. Deliberately a bar gauge rather than a table: a Loki instant query returns one frame per series, which a table panel renders awkwardly without extra transformations, while a bar gauge handles it natively. Use this to find what to quieten -- every distinct unit is a separate Loki stream, and stream count is what actually costs you.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-BlYlRd"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 15},
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false},
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "topk(15, sum by (host, unit) (count_over_time({job=\"systemd-journal\", host=~\"$host\"}[$__range])))",
          "legendFormat": "{{host}} / {{unit}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top 15 noisiest units (range)",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Error rate broken out by unit, so a spike tells you where to look immediately. Empty panel = no err/crit/alert/emerg in the range, which is the state you want.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "off"}
          },
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "logs"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 15},
      "id": 8,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "sum by (unit) (rate({job=\"systemd-journal\", host=~\"$host\", level=~\"err|crit|alert|emerg\"}[$__interval]))",
          "legendFormat": "{{unit}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors/sec by unit",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "id": 103,
      "panels": [],
      "title": "The logs themselves",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "Everything at priority warning or worse, newest first. This is the panel to read first when something is wrong.",
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 25},
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "{job=\"systemd-journal\", host=~\"$host\", level=~\"warning|err|crit|alert|emerg\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Warnings and errors",
      "type": "logs"
    },
    {
      "datasource": {"type": "loki", "uid": "${ds}"},
      "description": "All selected units, with a free-text filter. The $search variable is substituted into a LogQL line filter; leaving it empty yields |= \"\" which is a valid no-op that matches every line, so the panel works unfiltered.",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 36},
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${ds}"},
          "editorMode": "code",
          "expr": "{job=\"systemd-journal\", host=~\"$host\", unit=~\"$unit\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "All logs (filter with the Search box above)",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["tavlab", "loki", "logs"],
  "templating": {
    "list": [
