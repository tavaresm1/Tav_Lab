*.retry
*.pyc
__pycache__/
.venv/
venv/
.vscode/
.idea/
*.swp
.DS_Store

# Ansible
ansible/collections/
ansible/.ansible/
ansible/*.retry

# Vault password files should never be committed
.vault_pass
.vault_pass.txt
*.vault_pass

# The vault itself. It is encrypted, so this is defence in depth rather than the
# only thing standing between a secret and a public repo — but the README has
# always claimed this file is ignored, and until now it wasn't.
*.vault.yml

# Control-node SSH keys — generated per-host, must never be committed
control-node/ssh_keys/

# Control-node vault mount — the whole directory, not just *.vault.yml, so a
# plaintext file staged there on the way to `ansible-vault encrypt` can never be
# committed by accident.
control-node/vault/
*.pem
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub

# Local ephemeral files
*.local
*.tmp
